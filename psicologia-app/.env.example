NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-publishable-key

# ─── NOTIFICAÇÕES (E-mail & WhatsApp) ───────────────────────────────
# Escolha UM provedor de cada. Tudo é opcional.

# E-mail via Resend (recomendado, gratuito até 3.000/mês)
# Crie conta em https://resend.com e gere uma API key
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev

# WhatsApp via CallMeBot (gratuito para testes)
# Instruções: https://www.callmebot.com/blog/free-api-whatsapp-messages/
# 1. Abra https://api.callmebot.com/whatsapp.php phone=SEUNUMERO&text=START&apikey=KEY
# 2. Envie a mensagem START pelo WhatsApp
# 3. Copie a apikey retornada
CALLMEBOT_API_KEY=xxxxxx

# OU WhatsApp via Z-API (serviço brasileiro pago)
# ZAPI_INSTANCE=xxxxxxxx
# ZAPI_TOKEN=xxxxxxxx

# OU WhatsApp via Twilio (pago)
# TWILIO_SID=xxxxxxxx
# TWILIO_TOKEN=xxxxxxxx
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
